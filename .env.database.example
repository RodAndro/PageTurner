# Database Configuration - Read/Write Splitting

# Primary Database Connection (All writes go here)
DB_CONNECTION=mysql
DB_HOST=192.168.1.1                 # Master/Primary database IP
DB_PORT=3306
DB_DATABASE=pageturner_db
DB_USERNAME=pageturner_user
DB_PASSWORD=secure_password_here

# Read Replica Hosts (Read queries distributed here)
# Multiple hosts separated by comma for load distribution
DB_READ_HOST=192.168.1.2,192.168.1.3
DB_READ_PORT=3306

# Enable sticky connections for read-after-write consistency
# When true, after a write operation, subsequent reads use master until connection reset
DB_READ_WRITE_STICKY=true

# Alternative: Single replica (backup/failover scenario)
# DB_READ_HOST=192.168.1.2
# DB_READ_PORT=3306

# Cache Configuration (for Query Caching)
CACHE_DRIVER=redis
CACHE_PREFIX=pageturner_
REDIS_HOST=192.168.1.4              # Redis server for caching
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Query Logging (Development only)
DB_QUERY_LOG=false
DB_QUERY_LOG_FILE=storage/logs/queries.log

# Performance Monitoring
# Enable slow query logging (log queries taking longer than specified milliseconds)
DB_SLOW_QUERY_THRESHOLD=1000
DB_ENABLE_SLOW_QUERY_LOG=false
